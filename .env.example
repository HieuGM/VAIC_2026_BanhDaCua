# Root compose-level env. Copy to `.env` (same folder as docker-compose.yml).
# This feeds the postgres + data-api + nginx services via ${VAR} substitution.
#
# chatbot-service has its OWN env file: chatbot-service/.env
# (copy from chatbot-service/.env.example, fill NVIDIA/FPT/OpenAI keys).

# === PostgreSQL ===
DB=hanoi_heart
DB_USER=hanoiheart
# CHANGE to a strong password in production.
DB_PASS=hanoiheart

# === data-api CORS ===
# FE is same-origin behind nginx in prod, so this rarely matters.
# Comma-separated list if you need more than one origin.
CORS_ALLOWED_ORIGINS=http://heca.tolalinhne.site

# === Deploy target (reference only — nginx server_name is baked in nginx/conf.d/app.conf) ===
DOMAIN=heca.tolalinhne.site
SERVER_IP=14.225.222.131
