FPT_CLOUD_KEY=FPT_CLOUD_KEY
OPENAI_API_KEY=OPENAI_API_KEY
NVIDIA_API_KEY=NVIDIA_API_KEY
# RAG embedding via NVIDIA NIM bge-m3 (asymmetric, hosted — for low-RAM deploy)
RAG_EMBED_PROVIDER=openai
RAG_EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
RAG_EMBED_MODEL=baai/bge-m3
RAG_EMBED_DIM=1024
RAG_EMBED_ASYMMETRIC=true

# RAG rerank via FPT Cloud bge-reranker-v2-m3 (hosted — for low-RAM deploy)
RAG_RERANK_PROVIDER=fptcloud
RAG_RERANK_BASE_URL=https://mkp-api.fptcloud.com/v1
RAG_RERANK_MODEL=bge-reranker-v2-m3